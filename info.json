{
  "id": "raylea.mihoyo-accounts",
  "name": "米游社账号",
  "version": "0.1.0",
  "manifest_version": "4",
  "min_core_version": "0.7.0",
  "license": "AGPL-3.0-only",
  "metadata": {
    "description": "米游社扫码登录、加密账号库与三游戏账号共享",
    "author": "raylea"
  },
  "concurrency": 8,
  "events": [
    "message.private",
    "message.group",
    "config.changed",
    "scheduler.trigger"
  ],
  "services": [
    {
      "name": "accounts",
      "version": 1,
      "methods": [
        "list",
        "roles",
        "select",
        "execute",
        "delegation.create",
        "delegation.revoke",
        "public.execute",
        "ark.request"
      ]
    }
  ],
  "default_config": {
    "allowed_plugins": [
      {
        "plugin_id": "raylea.genshin",
        "games": [
          "genshin"
        ]
      },
      {
        "plugin_id": "raylea.starrail",
        "games": [
          "starrail"
        ]
      },
      {
        "plugin_id": "raylea.zzz",
        "games": [
          "zzz"
        ]
      }
    ]
  },
  "commands": [
    {
      "id": "login",
      "name": "扫码登录",
      "description": "使用米游社扫码绑定三游戏账号",
      "usage": "#扫码登录",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "扫码登录"
        ]
      }
    },
    {
      "id": "login-status",
      "name": "登录状态",
      "description": "查询并保存扫码结果",
      "usage": "#登录状态",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "登录状态"
        ]
      }
    },
    {
      "id": "login-cancel",
      "name": "取消登录",
      "description": "取消本人的扫码任务",
      "usage": "#取消登录",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "取消登录"
        ]
      }
    },
    {
      "id": "accounts",
      "name": "我的CK",
      "description": "查看脱敏账号与角色状态",
      "usage": "#我的CK",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?i:(?:原神|星铁|绝区零)?我的c(?:oo)?k(?:ie)?)$"
      }
    },
    {
      "id": "refresh",
      "name": "刷新CK",
      "description": "刷新指定账号，默认第一个账号",
      "usage": "#刷新CK [序号]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?i:刷新c(?:oo)?k(?:ie)?)$"
      }
    },
    {
      "id": "remove",
      "name": "删除CK",
      "description": "移除指定账号，默认第一个账号",
      "usage": "#删除CK [序号]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?i:(?:原神|星铁|绝区零)?删除c(?:oo)?k(?:ie)?)$"
      }
    },
    {
      "id": "device-bind",
      "name": "绑定设备",
      "description": "出现 10041 时绑定设备（在管理页加密导入）",
      "usage": "#绑定设备",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "绑定设备"
        ]
      }
    },
    {
      "id": "device-help",
      "name": "绑定设备帮助",
      "description": "如何获取与导入设备信息",
      "usage": "#绑定设备帮助",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "绑定设备帮助"
        ]
      }
    },
    {
      "id": "device-unbind",
      "name": "解绑设备",
      "description": "恢复本人账号的默认设备",
      "usage": "#解绑设备",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "解绑设备"
        ]
      }
    },
    {
      "id": "public-query",
      "name": "共享查询账号",
      "description": "本人私聊主动开启或关闭公共资料查询用途",
      "usage": "#共享查询账号 开启/关闭 [序号] [每日额度] [游戏]",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "共享查询账号"
        ]
      }
    },
    {
      "id": "check",
      "name": "检查CK",
      "description": "检查本人已保存登录状态，不刷新凭据",
      "usage": "#检查CK [序号]",
      "permission": "everyone",
      "trigger": {
        "type": "pattern",
        "pattern": "^(?i:(?:检查|我的)*c(?:oo)?k(?:ie)?(?:状态)*)$"
      }
    },
    {
      "id": "association-start",
      "name": "关联账号",
      "description": "本人跨聊天关联账号",
      "usage": "#关联账号",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "关联账号"
        ]
      }
    },
    {
      "id": "association-join",
      "name": "申请关联",
      "description": "本人跨聊天申请关联",
      "usage": "#申请关联 编号",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "申请关联"
        ]
      }
    },
    {
      "id": "association-status",
      "name": "关联进度",
      "description": "本人跨聊天关联进度",
      "usage": "#关联进度 编号",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "关联进度"
        ]
      }
    },
    {
      "id": "association-confirm",
      "name": "完成关联",
      "description": "本人跨聊天完成关联",
      "usage": "#完成关联 编号 目标用户ID",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "完成关联"
        ]
      }
    },
    {
      "id": "association-cancel",
      "name": "取消关联",
      "description": "本人跨聊天取消关联",
      "usage": "#取消关联 编号",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "取消关联"
        ]
      }
    },
    {
      "id": "associations",
      "name": "关联列表",
      "description": "本人跨聊天关联列表",
      "usage": "#关联列表",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "关联列表"
        ]
      }
    },
    {
      "id": "association-remove",
      "name": "解除关联",
      "description": "本人跨聊天解除关联",
      "usage": "#解除关联 序号",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "解除关联"
        ]
      }
    },
    {
      "id": "help",
      "name": "账号帮助",
      "description": "查看账号插件说明",
      "usage": "#账号帮助",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "账号帮助"
        ]
      }
    },
    {
      "id": "version",
      "name": "账号版本",
      "description": "查看账号插件说明",
      "usage": "#账号版本",
      "permission": "everyone",
      "trigger": {
        "type": "exact",
        "names": [
          "账号版本"
        ]
      }
    }
  ],
  "command_groups": [
    {
      "id": "accounts",
      "title": "统一账号",
      "commands": [
        "login",
        "login-status",
        "login-cancel",
        "accounts",
        "refresh",
        "remove",
        "device-bind",
        "device-help",
        "device-unbind",
        "public-query",
        "check",
        "association-start",
        "association-join",
        "association-status",
        "association-confirm",
        "association-cancel",
        "associations",
        "association-remove",
        "help",
        "version"
      ]
    }
  ],
  "help": {
    "title": "米游社账号",
    "summary": "私聊扫码一次，授权游戏插件共用账号；命令前缀沿用宿主设置。"
  },
  "management_ui": {
    "entry": "ui/index.html",
    "pages": [
      {
        "id": "accounts",
        "label": "账号管理"
      }
    ]
  }
}
